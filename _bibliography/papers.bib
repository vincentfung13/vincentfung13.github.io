@article{chen2026pistis,
  abbr     = {arXiv},
  title    = {Pistis Technical Report},
  author   = {Chen, Heyun and Lan, Xiaohan and Li, Jiaxi and Lu, Zhilin and She, Qi and Xu, Weiwen and Yu, Fei and Zhong, Yujie and Chen, Jinghuan and Feng, Zijian and Jiao, Siyu and Lin, Yiheng and Wang, Xinhao and Yang, Sihan and You, Jieyu and Zhang, Changbin and Zhang, Hengyu and Zhang, Xudong and Zhao, Yunqing and Zheng, Shuai},
  journal  = {arXiv preprint arXiv:2609.28554},
  year     = {2026},
  month    = {Sep},
  arxiv    = {2609.28554},
  abstract = {We introduce the Pistis model family, comprising 27B- and 9B-parameter multimodal large language models built on Qwen3.6 and Qwen3.5, respectively, and developed through a general and scalable post-training framework. The framework first establishes a strong foundation through large-scale multimodal supervised fine-tuning (SFT). Building on this SFT foundation, we propose Interleaved Distillation and Reinforcement Learning (IDRL), a novel post-training paradigm that tightly integrates on-policy distillation and reinforcement learning within a single training loop.},
  bibtex_show = {true},
  selected = {true}
}

@article{lin2026textsculptor,
  abbr     = {arXiv},
  title    = {TextSculptor: Training and Benchmarking Scene Text Editing},
  author   = {Lin, Yiheng and Jiao, Siyu and Lan, Xiaohan and Zhou, Wei and She, Qi and Yu, Fei and Chen, Heyun and Wang, Zhengwei and Chen, Jinghuan and Li, Moran and Yu, Yingchen and Feng, Zijian and Zhao, Yao and Wei, Yunchao and Zhong, Yujie},
  journal  = {arXiv preprint arXiv:2605.21090},
  year     = {2026},
  month    = {May},
  arxiv    = {2605.21090},
  code     = {https://github.com/linyiheng123/TextSculptor},
  abstract = {Recent advances in Multimodal Large Language Models (MLLMs) and diffusion-based generative models have substantially improved prompt-driven image editing. However, scene text editing remains challenging, as it requires models to precisely modify textual content while preserving visual realism and non-target regions. We present TextSculptor, a comprehensive framework for data construction and evaluation of scene text editing: an automated data construction pipeline, TextSculpt-Data (3.2M training samples), and TextSculpt-Bench, a benchmark covering text addition, replacement, removal and hybrid editing.},
  bibtex_show = {true},
  selected = {true}
}

